# GEMINI_API_KEY: Required for Gemini AI intelligent CV parsing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string (e.g. Render Managed Postgres)
# Leave empty in local preview to use the built-in local store automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentmatch"

# JWT_SECRET: Secret key used to sign authentication tokens.
JWT_SECRET="change-me-in-production-to-a-long-random-secret"

# CORS_ORIGIN: Allowed frontend origin (e.g. your Vercel domain)
CORS_ORIGIN="http://localhost:3000"

# PORT: HTTP server port (3000 for local/AI Studio, Render injects PORT automatically)
PORT=3000
